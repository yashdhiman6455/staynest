APP_NAME=StayNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Database — MySQL is used by StayNest.
# Create the database first, e.g. `CREATE DATABASE staynest;`
# ----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=staynest
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------------------------------------
# Public disk for property images. Run `php artisan storage:link` so
# uploaded files are reachable at the public /storage URL.
# ----------------------------------------------------------------------
FILESYSTEM_DISK=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@staynest.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# CORS — comma-separated list of origins allowed to call the API.
# Keep the Vite dev server origin here during development. In production
# the SPA is served by Laravel on the same origin, so no extra origin is
# required.
# ----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------
# Frontend build (Vite) — base URL used by Axios for API requests.
# Leave empty to call the API relative to the app origin (recommended).
# Set an absolute URL only when the API is hosted separately.
# ----------------------------------------------------------------------
VITE_API_URL=

# ----------------------------------------------------------------------
# Vite dev server proxy target (the Laravel backend).
# ----------------------------------------------------------------------
API_URL=http://127.0.0.1:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
